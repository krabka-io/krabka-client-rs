load("//bazel:defs.bzl", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "client-core")

crate_tests(
    # `src/security/tests.rs` embeds the TLS fixtures with `include_str!` and
    # `include_bytes!`.
    compile_data = glob(["tests/fixtures/**"]),
    lib = "client-core",
)
