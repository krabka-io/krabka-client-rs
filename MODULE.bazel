"""krabka-client-rs — Bazel module (bzlmod).

Bazel is the build and test path; Cargo stays the dependency source of truth.
`crate.from_cargo` reads the same `Cargo.toml` / `Cargo.lock` that Cargo does,
so there is no second dependency set to keep in sync.
"""

module(
    name = "krabka_client_rs",
    version = "0.4.0",
)

bazel_dep(name = "rules_rs", version = "0.0.112")
bazel_dep(name = "rules_rs_mutants", version = "0.0.1")

# rules_rs_mutants is not published to the Bazel Central Registry, so the
# `bazel_dep` above has nothing to resolve against without this override.
git_override(
    module_name = "rules_rs_mutants",
    # v0.0.1, resolved to a commit so the checkout is reproducible.
    commit = "fbc5c265b268cd050f2b392fbbf7ea4fb5b1a656",
    remote = "https://github.com/robot-head/rules_rs_mutants",
)

# A hermetic C++ toolchain rather than the host's.
#
# Bazel's autodetected toolchain links with whatever the machine happens to have.
# GitHub's runners carry `ld.gold`, so it passed `-fuse-ld=gold` and every link
# action printed "the gold linker is deprecated and has known bugs with Rust" --
# hundreds of lines per CI run, from a linker choice nothing here made. Pinning
# the toolchain links with lld instead, makes a local build and a CI build the
# same build, and is what rules_rs_mutants needs on macOS, where Xcode's
# cc_wrapper leaves a mutant link without `DEVELOPER_DIR`.
bazel_dep(name = "llvm", version = "0.8.24")

# rules_rs merges coverage with this module's llvm-profdata, which reads only
# the raw profile version of its own LLVM. rustc writes the version of the LLVM
# it was built on, so the two majors must match: 22.x for Rust 1.98 (`rustc
# -vV` prints it). The module's own default, 23.x, fails every test in `bazel
# coverage` with "raw profile version mismatch". Move this with the toolchain.
llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
llvm.version(llvm_version = "22.1.8")
use_repo(llvm, "llvm-project")

register_toolchains("@llvm//toolchain:all")

# ---------------------------------------------------------------------------
# Format and lint. See //tools/format and //tools/lint.
# ---------------------------------------------------------------------------
bazel_dep(name = "aspect_rules_lint", version = "2.9.0")

# Supplies a clippy aspect shaped the way `aspect lint` expects -- it writes the
# `rules_lint_machine` output group, which the aspect from @rules_rust does not.
# It registers `@default_rust_toolchains`, which the toolchain block below
# configures.
bazel_dep(name = "aspect_rules_lint_rust", version = "0.0.3")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")

# `sh_test`. //bazel/defs.bzl is shared verbatim across the three repositories,
# and its container-suite path builds one; no crate here uses that path today.
bazel_dep(name = "rules_shell", version = "0.8.0")

# A hermetic JDK. Like rules_shell above, this is here because //bazel/defs.bzl
# is shared verbatim and its container-suite path declares one; no crate here
# uses that path today.
bazel_dep(name = "rules_java", version = "9.9.0")

# rules_rs vends its own patched @rules_rust. `rust_doc_test` has no rules_rs
# wrapper, so it is loaded from there directly rather than from a second copy.
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

# ---------------------------------------------------------------------------
# Rust toolchain — pinned to the same channel as rust-toolchain.toml.
# ---------------------------------------------------------------------------
toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")

# Configured under the default repo name. aspect_rules_lint_rust imports
# `default_rust_toolchains` without configuring it, and rules_rs creates that
# repo only from a configuration, so this one is the toolchain both modules
# register.
toolchains.toolchain(
    edition = "2024",
    # rustfmt.toml sets `format_code_in_doc_comments`, `group_imports` and
    # `imports_granularity`, all still nightly-gated. Stable rustfmt does not
    # fail on them, it warns and silently skips them -- so a stable formatter
    # would quietly disagree with the tree, which CI formats with
    # `cargo +nightly fmt`. rules_rs pins rustfmt separately from rustc for
    # exactly this.
    rustfmt_version = "nightly/2026-08-14",
    # Matches rust-toolchain.toml. These had drifted apart -- Bazel built with
    # 1.97.0 while Cargo used 1.97.1 -- which is precisely the split the "one
    # dependency source of truth" arrangement exists to avoid.
    version = "1.98.1",
)
use_repo(toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//...")

# ---------------------------------------------------------------------------
# Native `-sys` crates, built by Bazel rather than by their build scripts.
#
# rules_rs ships a well-known annotation for each of these and warns on every
# build until it is applied. Each one otherwise compiles a bundled C library
# through a `cc`-crate build script: the host's compiler, its flags, and its
# headers, none of which the hermetic toolchain governs. Pointing them at the
# BCR's own builds puts that C under the same toolchain as everything else.
# ---------------------------------------------------------------------------
bazel_dep(name = "zstd", version = "1.5.7.bcr.2")

# ---------------------------------------------------------------------------
# Third-party crates, resolved from the Cargo workspace.
# ---------------------------------------------------------------------------
PLATFORM_TRIPLES = [
    "aarch64-apple-darwin",
    "aarch64-unknown-linux-gnu",
    "x86_64-apple-darwin",
    "x86_64-unknown-linux-gnu",
]

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = PLATFORM_TRIPLES,
)

# rules_rs_mutants deliberately ships no cargo-mutants binary: every consumer
# builds one from its own lockfile so the sweep and the build agree on a
# version. `//tools/mutants` is that lockfile.
crate.from_cargo(
    name = "mutants",
    cargo_lock = "//tools/mutants:Cargo.lock",
    cargo_toml = "//tools/mutants:Cargo.toml",
    platform_triples = PLATFORM_TRIPLES,
)

# The wire-layer crates come from the krabka-protocol repository, which is a
# Cargo workspace whose `members` is the glob `crates/*`. rules_rs resolves a
# git crate's directory by matching the crate name against the members list, and
# it skips glob entries, so each member's path is named here instead.
KRABKA_PROTOCOL_MEMBERS = {
    "krabka-compression": "crates/compression",
    "krabka-ids": "crates/ids",
    "krabka-metadata": "crates/metadata",
    "krabka-security": "crates/security",
    "krabka-trace-context": "crates/trace-context",
    "krabka-units": "crates/units",
    "krabka-voters": "crates/voters",
}

[
    crate.annotation(
        crate = crate_name,
        strip_prefix = directory,
        workspace_cargo_toml = "Cargo.toml",
    )
    for crate_name, directory in KRABKA_PROTOCOL_MEMBERS.items()
]

# krabka-protocol carries the same member annotation plus one more. Its build.rs
# only checks that its checked-in `generated/`
# sources still match the `schemas/` SHAs; it emits no code. It reads its own
# manifest directory through `env!("CARGO_MANIFEST_DIR")`, which rules_rust
# rejects because it bakes an absolute build path into the binary. Nothing here
# needs the check -- the generated sources are consumed directly -- and the
# Cargo build in krabka-protocol still runs it.
crate.annotation(
    crate = "krabka-protocol",
    gen_build_script = "off",
    strip_prefix = "crates/protocol",
    workspace_cargo_toml = "Cargo.toml",
)
crate.annotation(
    crate = "cargo-mutants",
    gen_binaries = ["cargo-mutants"],
    repositories = ["mutants"],
)
crate.annotation(
    crate = "zstd-sys",
    gen_build_script = "off",
    deps = ["@zstd"],
)
use_repo(crate, "crates", "mutants")
